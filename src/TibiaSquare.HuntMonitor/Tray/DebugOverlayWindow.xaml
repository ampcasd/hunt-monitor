<Window x:Class="TibiaSquare.HuntMonitor.Tray.DebugOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hunt Monitor — Live OCR"
        Width="960" Height="700"
        WindowStyle="SingleBorderWindow"
        Topmost="False"
        Background="#0a0a0b"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
    <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" Margin="10">
        <!-- Skills tab (default) -->
        <TabItem Header="Skills" IsSelected="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Parsed values -->
                        <Border Grid.Column="0" Background="#18181b" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Parsed Values" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Stamina" Foreground="#71717a" FontSize="12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SkillsValStamina" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Spatial map -->
                        <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="SkillsSpatialTitle" Text="Spatial Map" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                <Border Background="#09090b" CornerRadius="4" Height="260">
                                    <Canvas x:Name="SkillsSpatialCanvas" ClipToBounds="True"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status bar -->
                    <TextBlock x:Name="SkillsStatusText" Foreground="#52525b" FontSize="12" Margin="2,0,0,6" FontFamily="Consolas"/>

                    <!-- Raw OCR lines -->
                    <Border Background="#18181b" CornerRadius="6" Padding="10">
                        <TextBox x:Name="SkillsRawOcrText" Foreground="#a1a1aa" Background="Transparent" BorderThickness="0"
                                 FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"/>
                    </Border>
                </StackPanel>

                <!-- Right column: preprocessed image -->
                <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="0,0,0,8" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="SkillsPreprocessedTitle" Text="Preprocessed Image (Tesseract input)" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <Border Background="#09090b" CornerRadius="4" MinHeight="80">
                            <Image x:Name="SkillsPreprocessedImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- Hunt Analyser tab -->
        <TabItem Header="Hunt Analyser">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <!-- Parsed Values + Spatial Map side by side -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Parsed values -->
                            <Border Grid.Column="0" Background="#18181b" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Parsed Values" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"  Grid.Column="0" Text="Session" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="0"  Grid.Column="1" x:Name="ValSessionTime" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="1"  Grid.Column="0" Text="Raw XP Gain" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="1"  Grid.Column="1" x:Name="ValRawXpGain" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="2"  Grid.Column="0" Text="XP Gain" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="2"  Grid.Column="1" x:Name="ValXpGain" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="3"  Grid.Column="0" Text="Raw XP/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="3"  Grid.Column="1" x:Name="ValRawXpPerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="4"  Grid.Column="0" Text="XP/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="4"  Grid.Column="1" x:Name="ValXpPerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="5"  Grid.Column="0" Text="Loot" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="5"  Grid.Column="1" x:Name="ValLoot" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="6"  Grid.Column="0" Text="Supplies" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="6"  Grid.Column="1" x:Name="ValSupplies" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="7"  Grid.Column="0" Text="Balance" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="7"  Grid.Column="1" x:Name="ValBalance" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="8"  Grid.Column="0" Text="Damage" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="8"  Grid.Column="1" x:Name="ValDamage" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="9"  Grid.Column="0" Text="Damage/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="9"  Grid.Column="1" x:Name="ValDamagePerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Healing" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="10" Grid.Column="1" x:Name="ValHealing" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Healing/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="11" Grid.Column="1" x:Name="ValHealingPerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Monsters" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="12" Grid.Column="1" x:Name="ValMonsters" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Spatial map -->
                            <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="SpatialTitle" Text="Spatial Map" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                    <Border Background="#09090b" CornerRadius="4" Height="260">
                                        <Canvas x:Name="SpatialCanvas" ClipToBounds="True"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Status bar -->
                        <TextBlock x:Name="StatusText" Foreground="#52525b" FontSize="12" Margin="2,0,0,6" FontFamily="Consolas"/>

                        <!-- Raw OCR lines -->
                        <Border Background="#18181b" CornerRadius="6" Padding="10">
                            <TextBox x:Name="RawOcrText" Foreground="#a1a1aa" Background="Transparent" BorderThickness="0"
                                     FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"/>
                        </Border>
                    </StackPanel>

                    <!-- Right column: preprocessed image -->
                    <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="0,0,0,8" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="PreprocessedTitle" Text="Preprocessed Image (Tesseract input)" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <Border Background="#09090b" CornerRadius="4" MinHeight="80">
                                <Image x:Name="PreprocessedImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
