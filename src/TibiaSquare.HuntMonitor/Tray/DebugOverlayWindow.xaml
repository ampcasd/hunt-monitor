<Window x:Class="TibiaSquare.HuntMonitor.Tray.DebugOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hunt Monitor — Live OCR"
        Width="1200" Height="760" MinWidth="980" MinHeight="620"
        WindowStyle="SingleBorderWindow"
        Topmost="False"
        Background="#0a0a0b"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
    <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" Margin="10">
        <!-- Reordered in the constructor so Hunt Analyser is the primary tab. -->
        <TabItem x:Name="SkillsTab" Header="Skills">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Parsed values -->
                        <Border Grid.Column="0" Background="#18181b" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Parsed Values" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Stamina" Foreground="#71717a" FontSize="12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SkillsValStamina" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Spatial map -->
                        <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="SkillsSpatialTitle" Text="Spatial Map" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                <Border Background="#09090b" CornerRadius="4" Height="260">
                                    <Canvas x:Name="SkillsSpatialCanvas" ClipToBounds="True"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status bar -->
                    <TextBlock x:Name="SkillsStatusText" Foreground="#52525b" FontSize="12" Margin="2,0,0,6" FontFamily="Consolas"/>

                    <!-- Raw OCR lines -->
                    <Border Background="#18181b" CornerRadius="6" Padding="10">
                        <TextBox x:Name="SkillsRawOcrText" Foreground="#a1a1aa" Background="Transparent" BorderThickness="0"
                                 FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"/>
                    </Border>
                </StackPanel>

                <!-- Right column: preprocessed image -->
                <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="0,0,0,8" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="SkillsPreprocessedTitle" Text="Preprocessed Image (Tesseract input)" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <Border Background="#09090b" CornerRadius="4" MinHeight="80">
                            <Image x:Name="SkillsPreprocessedImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- XP Analyser tab -->
        <TabItem x:Name="XpAnalyserTab" Header="XP Analyser">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#18181b" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Parsed Values" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="XP/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="XpValXpPerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Raw XP/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="XpValRawXpPerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="XpSpatialTitle" Text="Spatial Map" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                    <Border Background="#09090b" CornerRadius="4" Height="260">
                                        <Canvas x:Name="XpSpatialCanvas" ClipToBounds="True"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="XpStatusText" Foreground="#52525b" FontSize="12" Margin="2,0,0,6" FontFamily="Consolas"/>

                        <Border Background="#18181b" CornerRadius="6" Padding="10">
                            <TextBox x:Name="XpRawOcrText" Foreground="#a1a1aa" Background="Transparent" BorderThickness="0"
                                     FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="0,0,0,8" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="XpPreprocessedTitle" Text="Preprocessed Image (Tesseract input)" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <Border Background="#09090b" CornerRadius="4" MinHeight="80">
                                <Image x:Name="XpPreprocessedImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- Hunt Analyser tab -->
        <TabItem x:Name="HuntAnalyserTab" Header="Hunt Analyser">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <!-- Parsed Values + Spatial Map side by side -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Parsed values -->
                            <Border Grid.Column="0" Background="#18181b" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Parsed Values" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"  Grid.Column="0" Text="Session" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="0"  Grid.Column="1" x:Name="ValSessionTime" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="1"  Grid.Column="0" Text="Raw XP Gain" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="1"  Grid.Column="1" x:Name="ValRawXpGain" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="2"  Grid.Column="0" Text="XP Gain" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="2"  Grid.Column="1" x:Name="ValXpGain" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="3"  Grid.Column="0" Text="Raw XP/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="3"  Grid.Column="1" x:Name="ValRawXpPerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="4"  Grid.Column="0" Text="XP/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="4"  Grid.Column="1" x:Name="ValXpPerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="5"  Grid.Column="0" Text="Loot" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="5"  Grid.Column="1" x:Name="ValLoot" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="6"  Grid.Column="0" Text="Supplies" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="6"  Grid.Column="1" x:Name="ValSupplies" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="7"  Grid.Column="0" Text="Balance" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="7"  Grid.Column="1" x:Name="ValBalance" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="8"  Grid.Column="0" Text="Damage" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="8"  Grid.Column="1" x:Name="ValDamage" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="9"  Grid.Column="0" Text="Damage/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="9"  Grid.Column="1" x:Name="ValDamagePerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Healing" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="10" Grid.Column="1" x:Name="ValHealing" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Healing/h" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="11" Grid.Column="1" x:Name="ValHealingPerHour" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Monsters" Foreground="#71717a" FontSize="12"/>
                                        <TextBlock Grid.Row="12" Grid.Column="1" x:Name="ValMonsters" Foreground="#e4e4e7" FontSize="12" FontFamily="Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Spatial map -->
                            <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="SpatialTitle" Text="Spatial Map" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                    <Border Background="#09090b" CornerRadius="4" Height="260">
                                        <Canvas x:Name="SpatialCanvas" ClipToBounds="True"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Status bar -->
                        <TextBlock x:Name="StatusText" Foreground="#52525b" FontSize="12" Margin="2,0,0,6" FontFamily="Consolas"/>

                        <!-- Reconstructed lines + preprocessing controls, mirroring the split above -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#18181b" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="OCR Output" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                    <TextBox x:Name="RawOcrText" Foreground="#a1a1aa" Background="Transparent" BorderThickness="0"
                                             FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" IsReadOnly="True"
                                             IsReadOnlyCaretVisible="False"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PreprocessingSettingsPanel" Grid.Column="1" Background="#18181b" CornerRadius="6"
                                    Padding="10" Margin="4,0,0,0" IsEnabled="False" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,2">
                                        <Button DockPanel.Dock="Right" Content="Reset" Padding="9,3" Margin="8,0,0,0"
                                                Background="#27272a" Foreground="#e4e4e7" BorderBrush="#3f3f46"
                                                Click="ResetPreprocessing_Click"/>
                                        <TextBlock Text="Global Preprocessing" Foreground="#fbbf24" FontWeight="Bold" FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="PreprocessingStatusText" Text="Waiting for OCR capture…"
                                               Foreground="#a1a1aa" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Preset" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="PreprocessingPresetCombo" Grid.Column="1" Height="28"
                                                  Background="#f4f4f5" Foreground="#18181b" BorderBrush="#3f3f46"
                                                  SelectionChanged="PreprocessingPreset_SelectionChanged"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Save as" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="PresetNameText" Grid.Column="1" MaxLength="40" Height="28"
                                                 Background="#09090b" Foreground="#e4e4e7" BorderBrush="#3f3f46" Padding="6,3"
                                                 VerticalContentAlignment="Center" KeyDown="PresetName_KeyDown"
                                                 ToolTip="Enter a name, then save the current preprocessing values"/>
                                        <Button Grid.Column="2" Content="Save" Margin="6,0,0,0" Padding="7,3"
                                                Background="#27272a" Foreground="#e4e4e7" BorderBrush="#3f3f46"
                                                Click="SavePreset_Click"/>
                                        <Button x:Name="DeletePresetButton" Grid.Column="3" Content="Delete" Margin="6,0,0,0" Padding="7,3"
                                                Background="#27272a" Foreground="#e4e4e7" BorderBrush="#3f3f46" IsEnabled="False"
                                                Click="DeletePreset_Click" ToolTip="Delete the selected custom preset"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/><RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/><RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/><RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Upscale" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider x:Name="UpscaleSlider" Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="5" Value="4"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="4,0,8,0"
                                                ValueChanged="PreprocessingSlider_ValueChanged"/>
                                        <TextBox x:Name="UpscaleText" Grid.Row="0" Grid.Column="2" Text="4" MaxLength="1"
                                                 Background="#09090b" Foreground="#e4e4e7" BorderBrush="#3f3f46" Padding="4,2"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 LostKeyboardFocus="PreprocessingText_LostKeyboardFocus" KeyDown="PreprocessingText_KeyDown"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Threshold" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider x:Name="ThresholdSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="107"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="4,0,8,0"
                                                ValueChanged="PreprocessingSlider_ValueChanged"/>
                                        <TextBox x:Name="ThresholdText" Grid.Row="1" Grid.Column="2" Text="107" MaxLength="3"
                                                 Background="#09090b" Foreground="#e4e4e7" BorderBrush="#3f3f46" Padding="4,2"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 LostKeyboardFocus="PreprocessingText_LostKeyboardFocus" KeyDown="PreprocessingText_KeyDown"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Smoothing" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider x:Name="SmoothingSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="2" Value="2"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="4,0,8,0"
                                                ToolTip="Softens pixel stair-steps before thresholding"
                                                ValueChanged="PreprocessingSlider_ValueChanged"/>
                                        <TextBox x:Name="SmoothingText" Grid.Row="2" Grid.Column="2" Text="2" MaxLength="1"
                                                 Background="#09090b" Foreground="#e4e4e7" BorderBrush="#3f3f46" Padding="4,2"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 LostKeyboardFocus="PreprocessingText_LostKeyboardFocus" KeyDown="PreprocessingText_KeyDown"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Dilation" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider x:Name="DilationSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="3" Value="1"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="4,0,8,0"
                                                ToolTip="Thickens every dark text stroke"
                                                ValueChanged="PreprocessingSlider_ValueChanged"/>
                                        <TextBox x:Name="DilationText" Grid.Row="3" Grid.Column="2" Text="1" MaxLength="1"
                                                 Background="#09090b" Foreground="#e4e4e7" BorderBrush="#3f3f46" Padding="4,2"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 LostKeyboardFocus="PreprocessingText_LostKeyboardFocus" KeyDown="PreprocessingText_KeyDown"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Dot boost" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider x:Name="DotEnhancementSlider" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="2" Value="0"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="4,0,8,0"
                                                ToolTip="Selectively enlarges detached dots above i/j stems"
                                                ValueChanged="PreprocessingSlider_ValueChanged"/>
                                        <TextBox x:Name="DotEnhancementText" Grid.Row="4" Grid.Column="2" Text="0" MaxLength="1"
                                                 Background="#09090b" Foreground="#e4e4e7" BorderBrush="#3f3f46" Padding="4,2"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 LostKeyboardFocus="PreprocessingText_LostKeyboardFocus" KeyDown="PreprocessingText_KeyDown"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Noise area" Foreground="#a1a1aa" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider x:Name="BlobAreaSlider" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="500" Value="0"
                                                TickFrequency="5" IsSnapToTickEnabled="True" Margin="4,0,8,0"
                                                ToolTip="Erases connected black components smaller than this many pixels"
                                                ValueChanged="PreprocessingSlider_ValueChanged"/>
                                        <TextBox x:Name="BlobAreaText" Grid.Row="5" Grid.Column="2" Text="0" MaxLength="3"
                                                 Background="#09090b" Foreground="#e4e4e7" BorderBrush="#3f3f46" Padding="4,2"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 LostKeyboardFocus="PreprocessingText_LostKeyboardFocus" KeyDown="PreprocessingText_KeyDown"/>
                                    </Grid>

                                    <TextBlock Text="These settings are shared by Hunt Analyser, Skills, and XP Analyser. Some stages only affect grey edges, colored values, coins, or borders."
                                               Foreground="#a1a1aa" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                    <WrapPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="ColorEnhancementCheck" Content="Color enhancement" IsChecked="True"
                                                  Foreground="#d4d4d8" Margin="0,0,12,7"
                                                  Checked="PreprocessingToggle_Changed" Unchecked="PreprocessingToggle_Changed"/>
                                        <CheckBox x:Name="CoinBlankingCheck" Content="Coin blanking" IsChecked="True"
                                                  Foreground="#d4d4d8" Margin="0,0,12,7"
                                                  Checked="PreprocessingToggle_Changed" Unchecked="PreprocessingToggle_Changed"/>
                                        <CheckBox x:Name="BottomBorderCheck" Content="Bottom-border crop" IsChecked="True"
                                                  Foreground="#d4d4d8" Margin="0,0,12,7"
                                                  Checked="PreprocessingToggle_Changed" Unchecked="PreprocessingToggle_Changed"/>
                                        <CheckBox x:Name="SmallBlobsCheck" Content="Remove small blobs" IsChecked="True"
                                                  Foreground="#d4d4d8" Margin="0,0,12,7"
                                                  Checked="PreprocessingToggle_Changed" Unchecked="PreprocessingToggle_Changed"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Right column: preprocessed image -->
                    <Border Grid.Column="1" Background="#18181b" CornerRadius="6" Padding="10" Margin="0,0,0,8" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="PreprocessedTitle" Text="Preprocessed Image (Tesseract input)" Foreground="#fbbf24" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <Border Background="#09090b" CornerRadius="4" MinHeight="80">
                                <Image x:Name="PreprocessedImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
